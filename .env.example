# Copy to .env and fill in. .env is gitignored.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=llb
POSTGRES_PASSWORD=llb_local_dev
POSTGRES_DB=llbsutra
# Host-side default. The API container overrides this to "db" via docker-compose.yml,
# so tools you run from Windows (ingest, deploy) reach Postgres on the published port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host-side connection (running ingest from your machine rather than the container)
# DATABASE_URL=postgresql://llb:llb_local_dev@localhost:5432/llbsutra

# --- Anthropic --------------------------------------------------------------
# Not needed for Phase 1 (corpus) or Phase 2 (retrieval). Required from Phase 3.
# Create a Console workspace with a MONTHLY SPEND LIMIT before using this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Ingestion --------------------------------------------------------------
# Government portals reject default HTTP clients; a real UA is required.
FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
FETCH_RATE_LIMIT_SECONDS=1.0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
